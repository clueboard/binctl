[tool.poetry]
name = "binctl-client"
version = "1.0.0"
description = "A client library for accessing binctl"
authors = []
readme = "README.md"
packages = [
    { include = "binctl_client" },
    { include = "binctl_cli" },
]
include = [
    "binctl_client/py.typed",
    { path = "binctl_client", format = ["sdist", "wheel"] },
    { path = "binctl_cli", format = ["sdist", "wheel"] },
]

[tool.poetry.dependencies]
python = "^3.11"
httpx = ">=0.23.1,<0.29.0"
attrs = ">=22.2.0"
milc = "*"

[tool.poetry.scripts]
binctl = "binctl_cli.entrypoint:cli"

[build-system]
requires = ["poetry-core>=2.0.0,<3.0.0"]
build-backend = "poetry.core.masonry.api"

[tool.ruff]
line-length = 120

[tool.ruff.lint]
select = ["F", "I", "UP"]
