# Uncomment exactly one DATABASE_URL for your database backend:

# SQLite (local file, no server required — good for development)
# DATABASE_URL=sqlite:///binctl.db

# MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost/binctl

# PostgreSQL
# DATABASE_URL=postgresql+psycopg2://user:password@localhost/binctl

# Comma-separated list of allowed CORS origins (required for browser clients)
# CORS_ORIGINS=https://example.com

# Preflight cache duration in seconds (default: 600)
# CORS_MAX_AGE=600

# Web session token lifetime in days (default: 30)
# SESSION_LIFETIME_DAYS=30

# Container label used to receive children of deleted containers (optional)
# ORPHAN_LOCATION="Lost and Found"

# Number of inventory events retained for reconnecting clients (default: 10000)
# EVENT_RETENTION_LIMIT=10000
